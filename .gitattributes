# Keep source and data files consistent across Windows, macOS, and Linux.
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ttl text eol=lf

# Text-like PDFs must retain their byte offsets; never normalize binary assets.
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.bin binary
