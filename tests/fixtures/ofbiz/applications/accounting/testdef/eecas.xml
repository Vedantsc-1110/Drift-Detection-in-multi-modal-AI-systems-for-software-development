<?xml version="1.0" encoding="UTF-8"?>
<entity-eca xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entity-eca.xsd">
    <eca entity="Invoice" operation="create-store" event="return">
        <condition field-name="statusId" operator="equals" value="INVOICE_READY"/>
        <action service="sendInvoiceNotification" mode="sync"/>
    </eca>
</entity-eca>
