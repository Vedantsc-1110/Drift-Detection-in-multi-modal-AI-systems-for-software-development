<?xml version="1.0" encoding="UTF-8"?>
<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/site-conf.xsd">
    <description>Order web controller (synthetic fixture modeled on OFBiz controller.xml).</description>
    <request-map uri="searchorders">
        <security auth="true"/>
        <event type="service" invoke="findOrders"/>
        <response name="success" type="view" value="findorders"/>
        <response name="error" type="view" value="findorders"/>
    </request-map>
    <request-map uri="orderview">
        <security auth="true"/>
        <event type="java" invoke="org.apache.ofbiz.order.web.OrderEvents.orderView"/>
        <response name="success" type="view" value="orderview"/>
    </request-map>
</site-conf>
